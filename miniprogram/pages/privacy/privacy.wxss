/* ===== 协议 / 隐私政策 文档页通用样式 ===== */
.page-doc {
  min-height: 100vh;
  background: #f7f3ee;
  padding: 32rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.doc-header {
  padding: 8rpx 8rpx 0;
}
.doc-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a3a3a;
  line-height: 1.4;
  display: block;
}
.doc-meta {
  font-size: 22rpx;
  color: #8a7e72;
  margin-top: 14rpx;
  display: block;
  line-height: 1.6;
}

.doc-body {
  margin-top: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.section {
  margin-bottom: 36rpx;
}
.section:last-child {
  margin-bottom: 0;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a7a7a;
  display: block;
  margin-bottom: 14rpx;
}
.sub-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d2a24;
  display: block;
  margin: 18rpx 0 10rpx;
}
.para {
  font-size: 26rpx;
  color: #3d3a34;
  line-height: 1.8;
  display: block;
  margin-bottom: 10rpx;
  text-align: justify;
}
.strong {
  font-weight: 700;
  color: #2d2a24;
}

.btn-back {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1a7a7a, #145c5c);
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 32rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(26, 122, 122, 0.3);
}
.btn-back:active {
  transform: scale(0.98);
  opacity: 0.9;
}
