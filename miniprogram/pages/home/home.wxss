/* ===== 首页 ===== */
.page-home {
  min-height: 100vh;
  background: #f7f3ee;
  padding-bottom: 40rpx;
}

/* 欢迎栏 */
.welcome-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx 0;
}
.welcome-greeting {
  font-size: 36rpx;
  font-weight: 700;
  color: #2d2a24;
  display: block;
}
.welcome-hint {
  font-size: 26rpx;
  color: #8a7e72;
  margin-top: 8rpx;
  display: block;
}
.welcome-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1a7a7a, #145c5c);
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

/* 步骤指示器 */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 40rpx 20rpx;
}
.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.step-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e0d8ce;
  color: #8a7e72;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}
.step.active .step-circle {
  background: #1a7a7a;
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(26,122,122,0.3);
}
.step-label {
  font-size: 22rpx;
  color: #b0a69b;
}
.step.active .step-label {
  color: #1a7a7a;
  font-weight: 600;
}
.step-line {
  width: 80rpx;
  height: 4rpx;
  background: #e0d8ce;
  margin: 0 16rpx;
  margin-bottom: 44rpx;
  border-radius: 2rpx;
  transition: background 0.3s;
}
.step-line.active {
  background: #1a7a7a;
}

/* 区块 */
.section {
  padding: 20rpx 32rpx;
  animation: fadeIn 0.35s ease-out;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2d2a24;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.section-tag {
  font-size: 22rpx;
  font-weight: 400;
  background: #e0ecec;
  color: #1a7a7a;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* ===== 类目列表（可展开） ===== */
.category-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.category-item {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  overflow: hidden;
  transition: all 0.2s;
}
.category-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
}
.category-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.category-icon {
  font-size: 34rpx;
}
.category-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d2a24;
}
/* 显示简介 */
.category-desc-wrap {
  padding: 0 24rpx 20rpx;
}
.category-desc {
  font-size: 24rpx;
  color: #6b6058;
  line-height: 1.5;
}

/* ===== 附件列表 ===== */
.category-doc-list {
  padding: 0 24rpx 20rpx;
}

.doc-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  background: #faf9f6;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  border: 1rpx solid #ece7df;
  overflow: hidden;
}

.doc-item:active {
  background: #f0ece6;
}

.doc-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.doc-info {
  flex: 1;
  min-width: 0;
}

.doc-name {
  font-size: 26rpx;
  color: #2d2a24;
  display: block;
  line-height: 1.4;
  word-break: break-all;
}

.doc-size {
  font-size: 22rpx;
  color: #b0a69b;
  margin-top: 4rpx;
  display: block;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}
.empty-icon { font-size: 72rpx; }
.empty-text {
  font-size: 28rpx;
  color: #b0a69b;
  margin-top: 16rpx;
}
